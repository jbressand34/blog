@startuml C4_Container_Blog
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Couche Container C4 — Blog

Person(bloguer, "Blogueur", "Publie et gère les articles, présente sa personne et ses objectifs")
Person(visiteur, "Visiteur", "Lit les articles, parcourt la taxonomie, consulte la présentation du site")

System_Ext(git, "Dépôt Git", "Articles et code versionnés, source du contenu au build")
System_Ext(vercel, "Vercel", "Hébergement et déploiement automatique depuis Git")

Container_Boundary(blog, "Blog") {
  Container(blog_web, "Application web", "Next.js, SSG", "Site statique généré au build (Markdown, taxonomie), servi en lecture seule")
}

Rel(visiteur, blog_web, "Consulte, lit les articles", "HTTPS")
Rel(bloguer, blog_web, "Consulte")
Rel(bloguer, git, "Dépose les articles (push)", "Git")
Rel(blog_web, git, "Lit le contenu au build", "Build")
Rel(blog_web, vercel, "Déployé et hébergé sur", "CDN")

@enduml
